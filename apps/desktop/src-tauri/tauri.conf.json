{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Happy Science",
  "version": "0.5.0",
  "identifier": "com.happyscience.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ai4s/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @ai4s/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Happy Science",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data:",
        "frame-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob: data:",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob: data:",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/happy-science-opencode",
      "binaries/happy-science-uv",
      "binaries/happy-science-agent-browser",
      "binaries/happy-science-osd"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        }
      }
    },
    "resources": {
      "../../../runtime/goal-plugin": "goal-plugin/",
      "../../../runtime/browser-plugin": "browser-plugin/",
      "../../../runtime/tools": "tools/",
      "../../../runtime/skills/external/ai4s-skills": "skills/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/external/agent-browser": "skills-agent-browser/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/opencode-profile/agent": "profile/agent/",
      "../../../runtime/opencode-profile/command": "profile/command/",
      "../../../runtime/harness": "harness/",
    "../../../runtime/acp-server": "acp-server/",
      "../../../examples/climate-trends": "examples/climate-trends/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
